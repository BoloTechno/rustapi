# Konfigurasi Database SQLite
DATABASE_URL=sqlite://tasks.db?mode=rwc

# JWT Secret untuk Autentikasi Pengguna (Minimal 32 karakter pada production)
JWT_SECRET=super_secret_jwt_key_with_at_least_32_characters_long_12345

# Masa Berlaku JWT Token dalam Jam (Default: 24 jam)
JWT_EXPIRATION_HOURS=24

# Lingkungan: development | production
ENVIRONMENT=development

# Host & Port Server
HOST=0.0.0.0
PORT=3000

# CORS Allowed Origins (pisahkan dengan koma, atau gunakan '*' untuk seluruh origin)
CORS_ALLOWED_ORIGINS=*

# Batas Waktu Request (Timeout dalam detik)
REQUEST_TIMEOUT_SECS=30

# Percayai header reverse proxy (X-Forwarded-For / X-Real-IP)
# Set 'true' HANYA jika server berada di balik reverse proxy (Nginx, Cloudflare)
TRUST_PROXY=false
